# Copy this file to .env and edit values if needed.

# Host where Ollama is running
OLLAMA_HOST=http://localhost:11434

# Main chat/generation model (already installed on this system)
OLLAMA_MODEL=llama3.2

# Embedding model used for FAISS vector search
OLLAMA_EMBED_MODEL=nomic-embed-text

# Flask session secret key
FLASK_SECRET_KEY=change-this-to-a-random-string
